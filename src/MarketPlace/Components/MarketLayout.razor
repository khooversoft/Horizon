<div style="background-color: black;width:100%">
    <div style="max-width: 1240px; margin-inline: auto;">
        <BlockFrame Height="450px" Width="100%" BackgroundImage="_content/MarketPlace/images/BadPet-top.png" />
    </div>
</div>

<MudText Typo="Typo.h3" Align="Align.Center" Style="width: 100%;padding:10px">SHOP BY PROBLEM</MudText>

<div style="max-width: 1240px; margin-inline: auto;">

    <MudStack Row="true" Justify="Justify.Center" Spacing="6" Wrap="Wrap.Wrap" Style="margin:20px">

        <MudCard Elevation="0" Square="true">
            <MudCardMedia Image="_content/MarketPlace/images/HappyDog.png" Height="100" />
            <MudCardContent>
                <MudText Typo="Typo.h5" Align="Align.Center" Style="width:100%">STINK</MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Style="width:100%">Deodorizing &amp; Bath</MudText>
            </MudCardContent>
        </MudCard>

        <MudCard Elevation="0" Square="true">
            <MudCardMedia Image="_content/MarketPlace/images/ItchDog.png" Height="100" />
            <MudCardContent>
                <MudText Typo="Typo.h5" Align="Align.Center" Style="width:100%">ITCH</MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Style="width:100%">Skin &amp; Allergies</MudText>
            </MudCardContent>
        </MudCard>

        <MudCard Elevation="0" Square="true">
            <MudCardMedia Image="_content/MarketPlace/images/ChilDog.png" Height="100" />
            <MudCardContent>
                <MudText Typo="Typo.h5" Align="Align.Center" Style="width:100%">CHILL</MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Style="width:100%">Calming &amp; Stress</MudText>
            </MudCardContent>
        </MudCard>

        <MudCard Elevation="0" Square="true">
            <MudCardMedia Image="_content/MarketPlace/images/BreathCat.png" Height="100" />
            <MudCardContent>
                <MudText Typo="Typo.h5" Align="Align.Center" Style="width:100%">BREATH</MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Style="width:100%">Dental Care</MudText>
            </MudCardContent>
        </MudCard>

        <MudCard Elevation="0" Square="true">
            <MudCardMedia Image="_content/MarketPlace/images/ShedCat.png" Height="100" />
            <MudCardContent>
                <MudText Typo="Typo.h5" Align="Align.Center" Style="width:100%">SHED</MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Style="width:100%">Comb and Grooming</MudText>
            </MudCardContent>
        </MudCard>

        <MudCard Elevation="0" Square="true">
            <MudCardMedia Image="_content/MarketPlace/images/PoopCat.png" Height="100" />
            <MudCardContent>
                <MudText Typo="Typo.h5" Align="Align.Center" Style="width:100%">POOP</MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Style="width:100%">Waste Bags &amp; Cleanup</MudText>
            </MudCardContent>
        </MudCard>

    </MudStack>
</div>

