@page "/products"
@inject ProductStoreActor productStoreActor
@inject NavigationManager _nav

<MudStack Row="true" Wrap="Wrap.Wrap" Style="margin:10px">
    @foreach (var product in Products ?? [])
    {
        <ProductCard @key="product.ProductId" Product="@product" />
    }
</MudStack>

@code {
    // Restore the prerendered list before interactive initialization so cards aren't removed and recreated.
    [PersistentState]
    public List<ProductDetailRecord>? Products { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Products ??= (await productStoreActor.GetAll()).ToList();
    }
}
