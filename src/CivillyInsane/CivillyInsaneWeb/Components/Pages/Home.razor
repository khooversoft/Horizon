    <MudImage Src="civilly-insane.png"
              Alt="Civilly Insane"
              Style="max-width: 10%; height: auto;" />
    <MudText Typo="Typo.h3">Wear Your Wild Side.</MudText>
    <MudText Typo="Typo.h6">Bold tees. Unapologetic attitude. Find your fit with Civilly Insane.</MudText>
</MudStack>
