@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inherits LayoutComponentBase

<MudThemeProvider Theme="@BlackOrange.Theme" IsDarkMode="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Fixed="true"
               Dense="false"
               Elevation="0"
               Gutters="true">

        <MudIconButton Icon="@Icons.Material.Outlined.Menu" OnClick="OpenCloseLeftPanel" aria-label="Toggle navigation" />

        <MudImage Src="civilly-insane-icon.png" Style="height: 50px; width: auto; object-fit: contain;" />

        <MudSpacer />

        <MudTextField @bind-Value="_search"
                      Variant="Variant.Outlined"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Outlined.Search"
                      Margin="Margin.Dense"
                      Clearable="true"
                      Style="background-color: white" />

        <MudSpacer />

        <AuthorizeView>
            <Authorized>
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    <MudText Typo="@Typo.body2" Style="color: white">@GetUserEmail(context.User)</MudText>
                    <MudButton Style="color: white" StartIcon="@Icons.Material.Outlined.Logout" Href="/account/logout">Log out</MudButton>
                </MudStack>
            </Authorized>
            <NotAuthorized>
                <MudButton Style="color: white" StartIcon="@Icons.Material.Outlined.Login" Href="/account/login">Log in</MudButton>
            </NotAuthorized>
        </AuthorizeView>

        @*         <MudFab StartIcon="@Icons.Material.Outlined.Person"
                Size="Size.Small"
                Variant="Variant.Text"
                Style="background-color: rgba(200, 200, 200, .8); color:white"
                aria-label="Profile" />
 *@
    </MudAppBar>

    <MudDrawer @bind-Open="_leftMenuOpen"
               Variant="DrawerVariant.Persistent"
               Breakpoint="Breakpoint.None"
               ClipMode="DrawerClipMode.Always"
               Width="75px"
               Style="padding: 0px">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="main-body">
        <div class="body-wrapper">
            @Body
        </div>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string? _search;
    private bool _leftMenuOpen = false;

    private static string? GetUserEmail(ClaimsPrincipal user) => user.Identity?.Name;

    private void OpenCloseLeftPanel() => _leftMenuOpen = !_leftMenuOpen;
}

