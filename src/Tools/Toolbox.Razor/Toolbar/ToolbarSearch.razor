@if (Show)
{
    <div style="flex: 0 0 auto; width: 250px; max-width: 100%; margin-right: 5px; margin-left: 5px;">
        <MudTextField @bind-Value="@_searchString"
                      @bind-Value:after="@(() => OnClick.InvokeAsync(_searchString ?? string.Empty))"
                      Placeholder="search"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      IconSize="Size.Medium"
                      Immediate=true
                      Clearable=true
                      Disabled="@Disabled"
                      FullWidth=true />
    </div>
}

@code {
    [Parameter] public EventCallback<string?> OnClick { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Show { get => OnClick.HasDelegate && field; set; } = true;

    private string? _searchString;
}
