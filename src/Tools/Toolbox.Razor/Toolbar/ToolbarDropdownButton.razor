@if(Show)
{
    <DropdownButton Color="@Color"
                    Options="@Options"
                    CurrentValue="@CurrentValue"
                    OnClick="OnClick"
                    Disabled="@Disabled"
                    Dense="false" />
}

@code {
    [Parameter] public IReadOnlyList<KeyValue<string>> Options { get; init; } = [];
    [Parameter] public EventCallback<string> OnClick { get; init; }
    [Parameter] public string? CurrentValue { get; set; }
    [Parameter] public Color Color { get; init; } = Color.Info;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Show { get => OnClick.HasDelegate && field; set; } = true;
}
