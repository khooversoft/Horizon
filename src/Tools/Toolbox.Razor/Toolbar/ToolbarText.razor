<MudText Typo="Typo.body1" Style="margin-left:10px;display:flex;flex-direction:column;line-height:1.1;">
    <MudStack Row="true" Spacing="2">
        <span style="@TextStyle">@Text</span>

        @if (SubText.IsNotEmpty())
        {
            <MudText Typo="Typo.caption">@SubText)</MudText>
        }
    </MudStack>
</MudText>

@code {
    [Parameter] public string Text { get; init; } = string.Empty;
    [Parameter] public string? SubText { get; init; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Show { get; set; } = true;

    private string TextStyle => string.Empty; // Dense? "font-size:0.9rem;" : string.Empty;
}
