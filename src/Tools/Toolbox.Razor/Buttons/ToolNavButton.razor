
@implements IDisposable

<MudPaper Elevation="0"
          @onclick="onClick"
          @onmouseenter="OnMouseEnter"
          @onmouseleave="OnMouseLeave"
          Style="@GetPaperStyle()">

    <MudStack Row="true" Spacing="0" AlignItems="AlignItems.Stretch">
        <MudPaper Width="3px" MaxWidth="3px" Square="true" Elevation="0" Style="@GetLeftBarStyle()" />
        <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="1" Style="@_iconFrameStyle">
            <MudIcon Icon="@Icon" Size="Size.Medium" Style="@GetContentStyle()" />
            @foreach (var line in Lines)
            {
                <MudText Typo="Typo.button" Style="@GetContentStyle()">@line</MudText>
            }
        </MudStack>
    </MudStack>
</MudPaper>


@code {
    @inject NavigationManager _navigation;
    [CascadingParameter] internal ToolNavBar? Parent { get; set; }
    [Parameter] public IReadOnlyList<string> Lines { get; set; } = [];
    [Parameter] public EventCallback<bool> OnClick { get; set; }
    [Parameter] public string Icon { get; set; } = MaterialSymbols.Outlined.Workspaces;
    [Parameter] public string? Href { get; set; }
    [Parameter] public bool Active { get; set; } = false;
    [Parameter] public bool Disabled { get; set; } = false;

    private bool _isActive = false;
    private bool _isHovering = false;
    private string _iconFrameStyle = string.Empty;

    protected override void OnParametersSet()
    {
        _isActive = Active || Parent?.IsControlActive(this) == true;

        int minHeight = 68 + (Lines.Count - 1) * 16; // Adjust min-height based on the number of lines
        _iconFrameStyle = $"width:64px; min-height:{minHeight}px; padding: 6px 2px 6px 2px;";
    }

    protected override void OnInitialized()
    {
        if (Parent is null)
        {
            throw new InvalidOperationException($"{nameof(ToolNavButton)} must be placed inside a {nameof(ToolNavBar)}.");
        }

        Parent.AddControl(this);
    }

    public void Dispose() => Parent?.RemovePanel(this);

    private async Task onClick()
    {
        if (Disabled || Parent is null) return;

        await Parent.MakeControlActive(this);
        await OnClick.InvokeAsync(true);

        if (Href.IsNotEmpty())
        {
            _navigation.NavigateTo(Href);
        }
    }

    internal void SetActive(bool isActive)
    {
        _isActive = isActive;
        StateHasChanged();
    }

    private string GetLeftBarStyle()
    {
        var backgroundColor = _isActive ? "var(--tool-background-color-menu-select-bar)" : "transparent";
        return $"background-color: {backgroundColor}; margin: 8px 1px 8px 0px; border-radius: 2px;";
    }

    private string GetPaperStyle()
    {
        var backgroundColor = (_isHovering || _isActive) && !Disabled ? "#DCFCE7" : "inherit";
        var cursor = Disabled ? "default" : "pointer";
        var opacity = Disabled ? "0.30" : "1";
        return $"background-color: {backgroundColor}; cursor: {cursor}; opacity: {opacity}; border-radius: 0;";
    }

    private string GetContentStyle()
    {
        var color = _isActive ? "var(--mud-palette-primary)" : "var(--mud-palette-text-primary)";
        return $"color: {color}; text-align: center; width: 100%; line-height: 1.15; white-space: normal;";
    }


    private void OnMouseEnter() => _isHovering = true;

    private void OnMouseLeave() => _isHovering = false;
}
