<div style="display:flex; flex-direction:column; min-height:95vh;background-color: var(--tool-background-color-menu);">

    @if (HeaderContent != null)
    {
        <div style="@GetHeaderStyle()">
            @HeaderContent
        </div>
    }

    <div style="display:flex; flex:1; min-height:0;">
        @if (LeftContent != null)
        {
            <div style="@GetLeftStyle()">
                @LeftContent
            </div>
        }

        <div style="flex:1; box-sizing:border-box;">
            @if (NoPaper)
            {
                @ChildContent
            }
            else
            {
                <MudPaper Width="100%" Height="100%" Style="padding:10px;background-color:var(--tool-background-color-page)" Square="false" Elevation="2">
                    @ChildContent
                </MudPaper>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public RenderFragment ChildContent { get; set; } = null!;
    [Parameter] public RenderFragment HeaderContent { get; set; } = null!;
    [Parameter] public RenderFragment LeftContent { get; set; } = null!;

    [Parameter] public WidthSize Size { get; set; } = WidthSize.Full;

    private string _minHeaderHeight = null!;
    private string _leftWidth = null!;
    [Parameter] public bool NoPaper { get; set; } = false;

    protected override void OnParametersSet()
    {
        (_minHeaderHeight, _leftWidth) = Size switch
        {
            WidthSize.Full => ("4.5rem", "16rem"),
            WidthSize.Form => ("4.5rem", "13rem"),
            _ => throw new ArgumentException(),
        };
    }

    private string GetHeaderStyle() => $"min-height:{_minHeaderHeight};padding: 0.5rem";
    private string GetLeftStyle() => $"width: {_leftWidth}; min-width: {_leftWidth}; margin-top:10px; padding: 0.5rem; box-sizing: border-box;";
}